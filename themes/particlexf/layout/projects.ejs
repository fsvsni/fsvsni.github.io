<%
    // 统计两个项目的文章数
    let kbCount = 0, opsCount = 0;
    site.posts.data.forEach(function (p) {
        if (!p.categories || !p.categories.data) return;
        let names = p.categories.data.map(function (c) { return c.name; });
        if (names.indexOf("企业知识库 RAG") !== -1) kbCount++;
        if (names.indexOf("设备运维 RAG") !== -1) opsCount++;
    });
%>
<div id="project-nav">
    <div class="project-cards">
        <a class="project-card" href="<%- url_for("/categories/企业知识库-RAG/") %>">
            <div class="pc-icon">
                <i class="fa-solid fa-building-columns"></i>
            </div>
            <div class="pc-body">
                <div class="pc-name">企业知识库 RAG</div>
                <div class="pc-desc">enterprise_knowledge · hr / it / finance 制度问答</div>
                <div class="pc-meta"><%= kbCount %> 篇学习笔记</div>
            </div>
            <div class="pc-go">进入项目 <i class="fa-solid fa-arrow-right"></i></div>
        </a>
        <a class="project-card" href="<%- url_for("/categories/设备运维-RAG/") %>">
            <div class="pc-icon">
                <i class="fa-solid fa-screwdriver-wrench"></i>
            </div>
            <div class="pc-body">
                <div class="pc-name">设备运维 RAG</div>
                <div class="pc-desc">equipment_ops · 巡检 / 告警 / 维修 / 工单</div>
                <div class="pc-meta"><%= opsCount %> 篇学习笔记</div>
            </div>
            <div class="pc-go">进入项目 <i class="fa-solid fa-arrow-right"></i></div>
        </a>
    </div>
    <div class="project-search">
        <div class="ps-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input id="project-search-input" type="text" placeholder="搜索全部笔记（标题 / 分类）…" autocomplete="off" />
        </div>
        <div id="project-search-results"></div>
    </div>
</div>
