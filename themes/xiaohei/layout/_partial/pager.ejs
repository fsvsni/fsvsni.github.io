<% if (page.total && page.total > 1) { %>
<nav class="pager">
  <% if (page.prev_link) { %>
  <a href="<%- url_for(page.prev_link) %>">较新</a>
  <% } else { %><span></span><% } %>
  <span class="pager-info"><%= page.current %> / <%= page.total %></span>
  <% if (page.next_link) { %>
  <a href="<%- url_for(page.next_link) %>">较早</a>
  <% } else { %><span></span><% } %>
</nav>
<% } %>
