<%
  const tree = category_tree();
  const currentPath = page.path || '';
  const isActive = (p) => currentPath === p || currentPath.indexOf(p) === 0;
%>
<aside class="sidebar" id="siteNav">
  <div class="side-group-wrap">
    <div class="side-group">
      <span class="side-group-ico"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 5a3 3 0 0 1 3-2h11v16H8a3 3 0 0 0-3 3V5z"/><path d="M8 3v16"/></svg></span>
      <span class="side-group-name">文章分类</span>
    </div>
    <div class="side-children">
      <% tree.forEach(function(node){ %>
        <% if (node.children.length) { const groupActive = isActive(node.path); %>
        <div class="side-l1">
          <button class="side-l1-row<%= groupActive ? ' active' : '' %>" type="button" data-l1="<%= node.name %>" aria-expanded="<%= groupActive ? 'true' : 'false' %>">
            <span class="side-ico"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/></svg></span>
            <span class="side-l1-name"><%= node.name %></span>
            <svg class="chev" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="side-l2<%= groupActive ? ' open' : '' %>">
            <% node.children.forEach(function(sub){ %>
            <a class="side-item<%= isActive(sub.path) ? ' active' : '' %>" href="<%- url_for(sub.path) %>">
              <span class="side-ico"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><circle cx="12" cy="12" r="3.5"/></svg></span>
              <span><%= sub.name %></span>
            </a>
            <% }) %>
          </div>
        </div>
        <% } else { %>
        <div class="side-l1">
          <a class="side-l1-row side-l1-link<%= isActive(node.path) ? ' active' : '' %>" href="<%- url_for(node.path) %>">
            <span class="side-ico"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 5a3 3 0 0 1 3-2h11v16H8a3 3 0 0 0-3 3V5z"/><path d="M8 3v16"/></svg></span>
            <span class="side-l1-name"><%= node.name %></span>
          </a>
        </div>
        <% } %>
      <% }) %>
    </div>
  </div>

  <div class="side-group-wrap">
    <div class="side-group">
      <span class="side-group-ico"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/></svg></span>
      <span class="side-group-name">站点</span>
    </div>
    <div class="side-children">
      <div class="side-l1">
        <a class="side-l1-row side-l1-link<%= currentPath === 'about/index.html' ? ' active' : '' %>" href="<%- url_for('/about/') %>">
          <span class="side-ico"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="3.2"/><path d="M5 19c1.2-3 3.6-4.5 7-4.5S17.8 16 19 19"/></svg></span>
          <span class="side-l1-name">关于</span>
        </a>
      </div>
      <div class="side-l1">
        <a class="side-l1-row side-l1-link<%= currentPath.indexOf('archives/') === 0 ? ' active' : '' %>" href="<%- url_for('/archives/') %>">
          <span class="side-ico"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="4" rx="1"/><rect x="3" y="10" width="18" height="4" rx="1"/><rect x="3" y="16" width="18" height="4" rx="1"/></svg></span>
          <span class="side-l1-name">归档</span>
        </a>
      </div>
    </div>
  </div>
</aside>
<div class="nav-backdrop" id="navBackdrop" hidden></div>
