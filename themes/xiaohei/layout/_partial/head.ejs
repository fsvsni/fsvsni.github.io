<%
  const isPost = page.layout === 'post';
  const fullUrl = (p) => config.url + '/' + String(p || '').replace(/^\/+/, '').replace(/index\.html$/, '');
  const canonical = fullUrl(page.path);
  const ogTitle = page.title || config.title;
  let ogDesc = config.description || '';
  if (page.description) ogDesc = page.description;
  else if (page.excerpt) ogDesc = plain_text(page.excerpt);
%>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= isPost || page.title ? page.title + ' · ' + config.title : config.title + (config.subtitle ? ' · ' + config.subtitle : '') %></title>
<meta name="description" content="<%= ogDesc %>">
<meta name="author" content="<%= config.author || theme.footer_name %>">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)">
<link rel="canonical" href="<%= canonical %>">

<meta property="og:type" content="<%= isPost ? 'article' : 'website' %>">
<meta property="og:site_name" content="<%= config.title %>">
<meta property="og:title" content="<%= ogTitle %>">
<meta property="og:description" content="<%= ogDesc %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:image" content="<%= config.url %>/img/cover.jpg">
<meta property="og:locale" content="zh_CN">
<% if (isPost && page.date) { %>
<meta property="article:published_time" content="<%= date_xml(page.date) %>">
<% } %>
<% if (isPost && page.tags.length) { page.tags.each(function(tag){ %>
<meta property="article:tag" content="<%= tag.name %>">
<% }) } %>

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= ogTitle %>">
<meta name="twitter:description" content="<%= ogDesc %>">
<meta name="twitter:image" content="<%= config.url %>/img/cover.jpg">

<link rel="icon" href="<%- url_for('/img/favicon.png') %>">
<link rel="alternate" type="application/atom+xml" title="<%= config.title %>" href="<%- url_for('/atom.xml') %>">
<link rel="stylesheet" href="<%- url_for('/css/style.css') %>">

<% if (isPost) { %>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BlogPosting","headline":<%- JSON.stringify(page.title) %>,"description":<%- JSON.stringify(ogDesc) %>,"image":"<%= config.url %>/img/cover.jpg","url":"<%= canonical %>"<% if (page.date) { %>,"datePublished":"<%= date_xml(page.date) %>"<% } %>,"author":{"@type":"Person","name":"<%= config.author || theme.footer_name %>"},"publisher":{"@type":"Organization","name":"<%= config.title %>"},"mainEntityOfPage":{"@type":"WebPage","@id":"<%= canonical %>"}<% if (page.tags.length) { %>,"keywords":<%- JSON.stringify(page.tags.toArray().map(function(t){return t.name;}).join(', ')) %><% } %>}</script>
<% } else { %>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":<%- JSON.stringify(config.title) %>,"description":<%- JSON.stringify(ogDesc) %>,"url":"<%= config.url + '/' %>","author":{"@type":"Person","name":"<%= config.author || theme.footer_name %>"},"inLanguage":"<%= config.language || 'zh-CN' %>"}</script>
<% } %>
<script>
  (function () {
    try {
      var t = localStorage.getItem('xiaohei-theme');
      if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', t);
    } catch (e) {}
  })();
</script>
